def triangular(num):
    cont = 1
    while True:
       if cont*(cont+1)*(cont+2) == num:
           return True

       elif cont*(cont+1)*(cont+2) > num:
           return False
       cont += 1

#main
N = int(input("Informe um número para verificar se ele é triângular: "))
if triangular(N):
    print(f"O número {N} é triângular!")
else:
    print(f"O número {N} NÃO é triângular!")
