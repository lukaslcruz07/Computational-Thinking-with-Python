N1 = int(input("Digite um número: "))
N2 = int(input("Digite outro número: "))

if N1 > N2:
    NF = N1 - N2
    print(f'{N1} é maior que {N2} e a difereça entre eles é {NF}')

elif N1 < N2:
    NF = N2 - N1
    print(f'{N2} é maior que {N1} e sua diferença entre eles é {NF} ')

else:
    print("Os dois números escolhidos são iguais.")
